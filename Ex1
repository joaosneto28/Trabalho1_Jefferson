package com.mycompany.mavenproject1;
import java.util.Scanner;
/**
 *
 * @author fef
 */
public class ex1_Estatisticas_de_uma_turma {

    /**
     * @param args the command line arguments
     */
    public static void main(String[] args) {
        Scanner ler = new Scanner(System.in);
        double[] notas = new double[10];
        double soma = 0;

        for (int i = 0; i < 10; i++) {
            System.out.print("Informe a nota do aluno " + (i + 1) + ": ");
            notas[i] = ler.nextDouble();
            soma += notas[i];
        }

        double media = soma / 10;
        double maior = notas[0];
        double menor = notas[0];
        int acimaOuIgualSete = 0;
        int abaixoDaMedia = 0;
 
        for (int i = 0; i < 10; i++) {
            if (notas[i] > maior) {
                maior = notas[i];
            }
            if (notas[i] < menor) {
                menor = notas[i];
            }
            if (notas[i] >= 7.0) {
                acimaOuIgualSete++;
            }
            if (notas[i] < media) {
                abaixoDaMedia++;
            }
        }

        System.out.println("\n--- RESULTADOS ---");
        System.out.printf("Media da turma: %.2f\n", media);
        System.out.println("Maior nota: " + maior);
        System.out.println("Menor nota: " + menor);
        System.out.println("Quantidade de alunos com nota >= 7.0: " + acimaOuIgualSete);
        System.out.println("Quantidade de alunos abaixo da media: " + abaixoDaMedia);
    }
    
}
