package com.mycompany.mavenproject1;
import java.util.Scanner;
/**
 *
 * @author fef
 */
public class ex3_Remoção_de_valores_repetidos{

    /**
     * @param args the command line arguments
     */
    public static void main(String[] args) {
        Scanner ler = new Scanner(System.in);
        int[] original = new int[15];
        int[] distintos = new int[15];
        int qtdDistintos = 0;

        System.out.println("Digite 15 numeros inteiros:");
        for (int i = 0; i < 15; i++) {
            original[i] = ler.nextInt();

            // Verifica se o número já existe no vetor de distintos
            boolean jaExiste = false;
            for (int j = 0; j < qtdDistintos; j++) {
                if (distintos[j] == original[i]) {
                    jaExiste = true;
                    break;
                }
            }

            // Se não existir, armazena
            if (!jaExiste) {
                distintos[qtdDistintos] = original[i];
                qtdDistintos++;
            }
        }

        System.out.print("\nValores distintos (na ordem de ocorrencia): ");
        for (int i = 0; i < qtdDistintos; i++) {
            System.out.print(distintos[i] + " ");
        }
        System.out.println("\nTotal de valores diferentes encontrados: " + qtdDistintos);
    }
}
